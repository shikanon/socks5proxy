/dist/
/.mobile-tools/
*.aar
*.apk
*.xcframework/
apps/android/.gradle/
apps/android/local.properties
apps/android/app/libs/
apps/android/**/build/
apps/ios/*.xcodeproj/
apps/ios/PacketTunnel/Info.plist
**/xcuserdata/
.DS_Store

# Private learning-mode token tables
token-table.json
.token-table-*

# Python bytecode caches
__pycache__/
*.py[cod]

# Private local installation/acceptance notes; public guide is docs/codex-proxy.md
/Codex专用代理配置.md
